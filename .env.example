# ---------------------------------------------------------------------------
# Stellar Network
# ---------------------------------------------------------------------------
# Which network to target: testnet | mainnet | local
NETWORK=testnet
# Soroban RPC endpoint for contract calls and simulations
RPC_URL=https://soroban-testnet.stellar.org
# Horizon endpoint for account/transaction/effect queries
HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar network passphrase (required when signing transactions)
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ---------------------------------------------------------------------------
# Soroban Contract
# ---------------------------------------------------------------------------
# Address of the deployed settlement contract
CONTRACT_ID=C...

# ---------------------------------------------------------------------------
# Order Book Service
# ---------------------------------------------------------------------------
# SQLite file path (development) or PostgreSQL connection URI (production)
DATABASE_URL=./orderbook.db
# Port the REST + WebSocket order book service listens on
ORDER_BOOK_PORT=3001
# Optional API key required for POST/DELETE /orders (empty = auth disabled)
ORDERBOOK_API_KEY=

# ---------------------------------------------------------------------------
# Keeper Bot
# ---------------------------------------------------------------------------
# Stellar secret key (S...) used by the keeper to sign & submit settlements
KEEPER_SECRET_KEY=S...
# Base URL of the order book service the keeper polls
ORDER_BOOK_URL=http://localhost:3001
# How often the keeper polls for new orders (milliseconds)
POLL_INTERVAL_MS=5000
# Minimum net profit ratio required before a keeper will settle an order
MIN_PROFIT_THRESHOLD=0.001
# Maximum settlement transactions submitted concurrently
MAX_CONCURRENT_SETTLEMENTS=3
# Port for the Prometheus /metrics endpoint
METRICS_PORT=9090
# Optional Slack webhook for keeper alerts (empty = alerts disabled)
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
# Horizon cursor used on first run (or "now" to start from the latest ledger)
INDEXER_START_CURSOR=now

# ---------------------------------------------------------------------------
# Frontend (Next.js — must be prefixed NEXT_PUBLIC_ to be inlined)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTRACT_ID=C...
NEXT_PUBLIC_ORDER_BOOK_URL=http://localhost:3001
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org