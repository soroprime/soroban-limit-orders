{
  "name": "@soroban-limit-orders/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for the Soroban Limit Order Protocol",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "test": "jest --forceExit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.0.0",
    "axios": "1.6.7",
    "tweetnacl": "1.0.3",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "25.0.7",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-typescript": "11.1.5",
    "@types/jest": "29.5.11",
    "@types/node": "20.11.5",
    "jest": "29.7.0",
    "rollup": "4.64.0",
    "rollup-plugin-dts": "6.1.0",
    "ts-jest": "29.1.2",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}